{
  "name": "@bifravst/timestream-helpers",
  "version": "0.0.0-development",
  "description": "Helper functions which simplify working with AWS Timestream",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "node": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "type": "module",
  "scripts": {
    "test": "node --experimental-transform-types --no-warnings --test ./src/*.spec.ts",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "prepublishOnly": "npx tsc --noEmit false -d"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bifravst/timestream-helpers.git"
  },
  "bugs": {
    "url": "https://github.com/bifravst/timestream-helpers/issues"
  },
  "homepage": "https://github.com/bifravst/timestream-helpers",
  "keywords": [
    "nrf-asset-tracker",
    "iot"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@aws-sdk/client-timestream-query": ">= 3 < 4",
    "@aws-sdk/client-timestream-write": ">= 3 < 4"
  },
  "devDependencies": {
    "@bifravst/eslint-config-typescript": "8.0.0",
    "@bifravst/prettier-config": "2.0.0",
    "@commitlint/config-conventional": "21.2.2",
    "@types/backoff": "2.5.5",
    "@types/node": "26.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "check-node-version": "4.2.1",
    "commitlint": "21.2.2",
    "husky": "9.1.7",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "prettier": "@bifravst/prettier-config"
}
